# ============================================
# RoomFlow - Üretim Ortamı Değişkenleri
# ============================================
# Bu dosyayı kopyalayarak .env dosyası oluşturun
# UYARI: Asla .env dosyasını Git'e commit etmeyin!

# ===== SUNUCU =====
PORT=3000
NODE_ENV=production
BASE_URL=https://roomflow-backend.onrender.com

# ===== VERİTABANI - MongoDB Atlas =====
# https://www.mongodb.com/cloud/atlas adresinden DB oluşturun
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/roomflow?retryWrites=true&w=majority

# ===== JWT GÜVENLİĞİ =====
# Güvenli bir anahtar oluşturun: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-here
JWT_EXPIRE=7d

# ===== WEBRTC TURN SUNUCUSU =====
TURN_SERVER_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_PASSWORD=openrelayproject
# İsteğe bağlı: Kendi TURN sunucunuzu kullanın (Coturn)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_PASSWORD=your-password

# ===== SMTP - Email Bildirimleri =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@roomflow.app

# ============================================
# ÖDEME SİSTEMLERİ (Seçimli: En az birini ayarlayın)
# ============================================

# --- iyzico (Türkiye - ÖNERİLEN) ---
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://api.iyzipay.com
# Test modu: https://sandbox-api.iyzipay.com

# --- PayTR (Türkiye) ---
PAYTR_MERCHANT_ID=your-merchant-id
PAYTR_MERCHANT_KEY=your-merchant-key
PAYTR_WEBHOOK_SECRET=your-webhook-secret

# --- Stripe (Global) ---
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# PREMIUM PLAN FİYATLANDIRMASI
# ============================================
PREMIUM_PRICE_MONTHLY=1500  # 15 TL (kuruş cinsinden) / iyzico için
PREMIUM_PRICE_MONTHLY_STRIPE=5  # 5 USD / Stripe için
PREMIUM_DURATION_DAYS=30

# ===== ÜCRETSIZ PLAN LİMİTLERİ =====
FREE_PLAN_MAX_PARTICIPANTS=5
FREE_PLAN_MAX_DURATION_MINUTES=30
FREE_PLAN_SCREEN_QUALITY=720
FREE_PLAN_AUDIO_QUALITY=16000

# ===== PREMIUM PLAN LİMİTLERİ =====
PREMIUM_PLAN_MAX_PARTICIPANTS=25
PREMIUM_PLAN_MAX_DURATION_MINUTES=0  # 0 = sınırsız
PREMIUM_PLAN_SCREEN_QUALITY=1080
PREMIUM_PLAN_AUDIO_QUALITY=48000

# ============================================
# CORS - Frontend URL
# ============================================
FRONTEND_URL=https://roomflow.vercel.app
CORS_ORIGIN=https://roomflow.vercel.app

# ============================================
# GELİŞTİRİCİ AYARLARI
# ============================================
DEBUG=false
LOG_LEVEL=info  # info, warn, error, debug

# ===== Socket.io =====
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# ===== Compression =====
ENABLE_COMPRESSION=true

# ============================================
# ANALYTICS (İsteğe Bağlı)
# ============================================
GOOGLE_ANALYTICS_ID=G-YOUR-ID

# ============================================
# DOSYA YÜKLEMESİ (İsteğe Bağlı: AWS S3)
# ============================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=roomflow-uploads
# AWS_REGION=eu-west-1
