# ============================================
# RoomFlow - Çevre Değişkenleri
# ============================================

# Sunucu
PORT=3000
NODE_ENV=development

# JWT ve Güvenlik
JWT_SECRET=super-gizli-anahtar-buraya-yazin-uretim-icin-guvenli-bir-degisken-kullanin
JWT_EXPIRE=7d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/roomflow

# WebRTC TURN Sunucusu
TURN_SERVER_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_PASSWORD=openrelayproject

# ============================================
# ÖDEME SİSTEMİ (Seçenek: iyzico, PayTR, Stripe)
# ============================================

# iyzico
IYZICO_API_KEY=test-api-key
IYZICO_SECRET_KEY=test-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR
PAYTR_MERCHANT_ID=test-merchant-id
PAYTR_MERCHANT_KEY=test-merchant-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================
# Premium Planı Fiyatlandırması
# ============================================
PREMIUM_PRICE_MONTHLY=1500  # 15 TL (kuruş cinsinden)
PREMIUM_DURATION_DAYS=30

# ============================================
# Ücretsiz Plan Limitleri
# ============================================
FREE_PLAN_MAX_PARTICIPANTS=5
FREE_PLAN_MAX_DURATION_MINUTES=30
FREE_PLAN_SCREEN_QUALITY=720

# ============================================
# Premium Plan Limitleri
# ============================================
PREMIUM_PLAN_MAX_PARTICIPANTS=25
PREMIUM_PLAN_MAX_DURATION_MINUTES=0  # 0 = sınırsız
PREMIUM_PLAN_SCREEN_QUALITY=1080
